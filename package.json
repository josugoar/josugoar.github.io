{
  "name": "josugoar.github.io",
  "version": "2.2.0",
  "keywords": [
    "astro-starter",
    "gh-pages",
    "github-api",
    "graphql",
    "primer"
  ],
  "bugs": {
    "url": "https://github.com/josugoar/josugoar.github.io/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/josugoar/josugoar.github.io"
  },
  "author": {
    "name": "josugoar",
    "url": "https://github.com/josugoar"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "gh-pages --dist dist",
    "astro": "astro",
    "check": "tsc --noEmit"
  },
  "prettier": {
    "semi": false
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "sourceType": "module"
    },
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react/recommended",
      "plugin:prettier/recommended"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "@primer/css": "^21.0.7",
    "@primer/octicons": "^19.5.0",
    "@primer/view-components": "^0.53.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "astro": "^5.13.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.64.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "gh-pages": "^5.0.0",
    "prettier": "^3.0.1",
    "typescript": "^5.0.0"
  }
}
