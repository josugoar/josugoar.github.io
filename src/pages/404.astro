---
import "../styles/index.scss"
---

<html lang="en" data-color-mode="auto" data-light-theme="light" data-dark-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>Page not found</title>
  </head>
  <body>
    <main class="font-mktg">
      <div
        class="position-relative"
        style="z-index:0;transition:all 0.25s easi-in"
      >
        <div
          class="position-relative d-flex my-0 mx-auto overflow-hidden"
          style="width:100vh;height:100vh;clear:both;flex-direction:column;align-items:center;justify-content:center"
        >
          <h1 style="font-size:125px">404</h1>
          <p style="width:215px;font-size:30px;font-weight:bold">
            This is not the web page you are looking for.
          </p>
          <a style="margin-top:20px;font-size:20px" href="/">Go home</a>
        </div>
      </div>
    </main>
  </body>
</html>
