---
import Repository, { type RepositoryProps } from "./Repository.astro"

interface RepositoryNodeProps extends RepositoryProps {
  id: string
}

export interface RepositoryConnectionProps {
  nodes: RepositoryNodeProps[]
}

type Props = RepositoryConnectionProps

const { nodes } = Astro.props
---

<div class="col-md-8" style="margin: auto; max-width: 700px;">
  {
    nodes.map(({ id, ...node }) => (
      <Repository {...node} />
    ))
  }
</div>
