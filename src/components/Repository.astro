---
import octicons from "@primer/octicons"
import LanguageConnection, {
  type LanguageConnectionProps,
} from "./LanguageConnection.astro"
import RepositoryTopicConnection, {
  type RepositoryTopicConnectionProps,
} from "./RepositoryTopicConnection.astro"

export interface RepositoryProps {
  description: string | null
  languages: LanguageConnectionProps
  name: string
  openGraphImageUrl: string
  repositoryTopics: RepositoryTopicConnectionProps
  url: string
  usesCustomOpenGraphImage: boolean
}

type Props = RepositoryProps

const {
  description,
  languages,
  name,
  openGraphImageUrl,
  repositoryTopics,
  url,
  usesCustomOpenGraphImage,
} = Astro.props
---

<article class="border rounded-1 color-shadow-small color-bg-subtle my-4">
  {
    usesCustomOpenGraphImage && (
      <a
        class="overflow-hidden d-block rounded-top-1 color-border-default border-bottom"
        href={url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          class="d-block width-full"
          style="height: auto;"
          width="1280"
          height="640"
          loading="lazy"
          src={openGraphImageUrl}
          alt={name}
        />
      </a>
    )
  }
  <div class="px-3">
    <div class="d-flex flex-justify-between my-3">
      <div class="d-flex flex-auto">
        <span
          set:html={octicons.repo.toSVG({ class: "color-fg-default mr-2" })}
          style="margin-top: 2px;"
        />
        <h1 class="f3 color-fg-muted text-normal lh-condensed">
          <a class="text-bold" href={url} target="_blank" rel="noopener noreferrer">
            {name}
          </a>
        </h1>
      </div>
    </div>
  </div>
  <div class="tabnav px-3 mb-0">
    <nav class="tabnav-tabs" aria-label="Repository menu">
      <a
        aria-current="true"
        href={url}
        class="tabnav-tab f6 px-2 py-1"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span set:html={octicons.code.toSVG({ class: "color-fg-default" })} />
        {" "}
        Code
      </a>
    </nav>
  </div>
  <div class="border-bottom color-bg-default">
    <div class="px-3 pt-3">
      <p class="color-fg-muted mb-0"></p>
      <div>{description}</div>
      <p></p>
    </div>
    <RepositoryTopicConnection {...repositoryTopics} />
    <LanguageConnection {...languages} />
  </div>
</article>

<style>
  .tabnav {
    border-bottom: var(--borderWidth-thin, 1px) solid var(--borderColor-default);
    margin-bottom: var(--stack-gap-normal, 16px);
    margin-top: 0;
  }

  .tabnav-tabs {
    display: flex;
    margin-bottom: calc(var(--borderWidth-thin, 1px) * -1);
    overflow: auto;
  }

  .tabnav-tab {
    background-color: transparent;
    border: var(--borderWidth-thin, 1px) solid transparent;
    border-bottom: 0;
    color: var(--fgColor-muted);
    display: inline-block;
    flex-shrink: 0;
    font-size: var(--text-body-size-medium, 14px);
    line-height: 23px;
    padding: var(--base-size-8, 8px) var(--control-medium-paddingInline-spacious, 16px);
    text-decoration: none;
  }

  .tabnav-tab.selected,
  .tabnav-tab[aria-current]:not([aria-current="false"]),
  .tabnav-tab[aria-selected="true"] {
    background-color: var(--bgColor-default);
    border-color: var(--borderColor-default);
    border-radius: var(--borderRadius-medium, 6px) var(--borderRadius-medium, 6px) 0 0;
    color: var(--fgColor-default);
  }

  .tabnav-tab:hover {
    color: var(--fgColor-default);
    text-decoration: none;
  }

  .tabnav-tab :global(.octicon) {
    color: var(--fgColor-muted);
    margin-right: var(--control-small-gap, 4px);
  }
</style>
