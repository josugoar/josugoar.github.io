---
export interface UserProps {
  bio: string | null
  databaseId: number
  login: string
  name: string | null
  url: string
}

type Props = UserProps

const { bio, databaseId, login, name, url } = Astro.props
---

<div
  class="flex-shrink-0 col-12 col-md-3 pt-4 position-md-sticky user-profile mx-auto mx-md-0"
  style="top: 0; max-width: 640px;"
>
  <div itemscope itemtype="http://schema.org/Person">
    <div class="clearfix d-flex d-md-block flex-items-center mb-4 mb-md-0">
      <div
        class="position-relative d-inline-block col-3 col-md-12 mr-3 mr-md-0 flex-shrink-0"
        style="z-index: 4;"
      >
        <a class="d-block" href={url} target="_blank" rel="noopener noreferrer">
          <img
            class="avatar avatar-user width-full border color-bg-default"
            style="height: auto;"
            alt={login}
            src={`https://avatars.githubusercontent.com/u/${databaseId}?v=4`}
            width="260"
            height="260"
          />
        </a>
      </div>
      <div
        class="vcard-names-container float-left col-9 col-md-12 pt-1 pt-md-3 pb-1 pb-md-3"
        style="position: sticky;"
      >
        <h1 class="vcard-names pl-2 pl-md-0">
          <span class="vcard-fullname d-block overflow-hidden" itemprop="name">
            {name}
          </span>
          <span class="vcard-username d-block" itemprop="additionalName">
            {login}
          </span>
        </h1>
      </div>
    </div>
    <div class="d-flex flex-column">
      <div class="d-flex flex-column d-md-block">
        {
          bio && (
            <div class="user-profile-bio f4">
              <div>{bio}</div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  .avatar {
    background-color: var(--bgColor-default);
    border-radius: var(--borderRadius-medium, 6px);
    box-shadow: 0 0 0 1px var(--borderColor-default);
    display: inline-block;
    flex-shrink: 0;
    line-height: 1;
    overflow: hidden;
    vertical-align: middle;
  }

  .avatar-user {
    border-radius: 50% !important;
  }

  .user-profile {
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .user-profile {
      height: 100vh;
    }
  }

  .user-profile-bio {
    overflow: hidden;
    font-size: 14px;
  }

  .vcard-names {
    line-height: 1;
  }

  .vcard-fullname {
    font-size: 26px;
    line-height: 1.25;
  }

  .vcard-username {
    font-size: 20px;
    font-style: normal;
    font-weight: 300;
    line-height: 24px;
    color: var(--color-text-secondary);
  }

  .vcard-names-container {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
  }
</style>
