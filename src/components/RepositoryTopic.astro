---
export interface RepositoryTopicProps {
  topic: {
    name: string
  }
}

type Props = RepositoryTopicProps

const {
  topic: { name },
} = Astro.props
---

<span class="topic-tag f6 mb-2" title={`Topic: ${name}`}>{name}</span>

<style>
  .topic-tag {
    display: inline-block;
    padding: 0.3em 0.9em;
    margin: 0 0.5em 0.5em 0;
    white-space: nowrap;
    color: var(--fgColor-accent);
    background-color: var(--bgColor-accent-muted);
    border-radius: 6px;
  }

  .topic-tag {
    display: inline-block;
    margin: 0 0.125em 0.333em 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 18px;
    border: 1px solid transparent;
    border-radius: 2em;
    padding: 0 10px;
    line-height: 22px;
    color: var(--fgColor-accent);
    background-color: var(--bgColor-accent-muted);
  }
</style>
