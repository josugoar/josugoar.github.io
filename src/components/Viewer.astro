---
import RepositoryConnection, {
  type RepositoryConnectionProps,
} from "./RepositoryConnection.astro"
import User, { type UserProps } from "./User.astro"

export interface ViewerProps extends UserProps {
  repositories: RepositoryConnectionProps
}

type Props = ViewerProps

const { repositories, ...user } = Astro.props
---

<div class="gutter-condensed flex-column flex-md-row d-flex mx-md-2 mx-lg-3">
  <User {...user} />
  <RepositoryConnection {...repositories} />
</div>
