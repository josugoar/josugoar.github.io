---
import PinnableItemConnection, {
  type PinnableItemConnectionProps,
} from "./PinnableItemConnection.astro"
import User, { type UserProps } from "./User.astro"

export interface ViewerProps extends UserProps {
  pinnedItems: PinnableItemConnectionProps
}

type Props = ViewerProps

const { pinnedItems, ...user } = Astro.props
---

<div class="gutter-condensed flex-column flex-md-row d-flex mx-md-2 mx-lg-3">
  <User {...user} />
  <PinnableItemConnection {...pinnedItems} />
</div>
