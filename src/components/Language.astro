---
export interface LanguageProps {
  color: string
  name: string
}

type Props = LanguageProps

const { color, name } = Astro.props
---

<span class="f6 my-1 ml-0">
  <span class="repo-language-color" style={`background-color: ${color}`}></span>
  {" "}
  <span itemprop="programmingLanguage">{name}</span>
</span>

<style>
  .repo-language-color {
    position: relative;
    top: 1px;
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 1px solid;
    border-radius: 50%;
  }
</style>
